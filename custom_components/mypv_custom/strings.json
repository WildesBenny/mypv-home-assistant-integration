{
  "title": "myPV (Custom)",
  "config": {
    "step": {
      "user": {
        "title": "my-PV device",
        "description": "Enter the IP address or hostname of your my-PV device. The device is used entirely locally.",
        "data": {
          "host": "Host"
        },
        "data_description": {
          "host": "The IP address or hostname of your my-PV device."
        }
      },
      "auth": {
        "title": "{name} password",
        "data": {
          "password": "Password"
        },
        "data_description": {
          "password": "The password of your my-PV device. If no custom password is set use the device key, found in the info menu of the device (or on the label of the HEA•THOR IoT)."
        }
      },
      "discovery_confirm": {
        "title": "{name}",
        "description": "Do you want to set up {name}?"
      },
      "discovery_auth": {
        "title": "{name}",
        "description": "Do you want to set up {name}?",
        "data": {
          "password": "Password"
        },
        "data_description": {
          "password": "The password of your my-PV device. If no custom password is set use the device key, found in the info menu of the device (or on the label of the HEA•THOR IoT)."
        }
      },
      "reauth_confirm": {
        "title": "{name} password",
        "description": "The password of your my-PV device changed. Enter the new password.",
        "data": {
          "password": "Password"
        },
        "data_description": {
          "password": "The password of your my-PV device. If no custom password is set use the device key, found in the info menu of the device (or on the label of the HEA•THOR IoT)."
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect",
      "invalid_password": "Invalid password"
    },
    "abort": {
      "already_configured": "This device is already configured",
      "cannot_connect": "Failed to connect",
      "unsupported_device": "This my-PV device is not supported",
      "reauth_successful": "Reauthentication was successful"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "my-PV options",
        "data": {
          "advanced": "Show advanced settings"
        },
        "data_description": {
          "advanced": "Expose advanced settings such as network configuration, boost schedules and diagnostics."
        }
      }
    }
  },
