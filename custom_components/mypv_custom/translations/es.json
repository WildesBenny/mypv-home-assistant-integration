{
  "title": "myPV (Personalizado)",
  "config": {
    "step": {
      "user": {
        "title": "Dispositivo my-PV",
        "description": "Introduce la dirección IP o el nombre de host de tu dispositivo my-PV. El dispositivo se usa completamente de forma local.",
        "data": {
          "host": "Host"
        },
        "data_description": {
          "host": "La dirección IP o el nombre de host de tu dispositivo my-PV."
        }
      },
      "auth": {
        "title": "{name} contraseña",
        "data": {
          "password": "Contraseña"
        },
        "data_description": {
          "password": "La contraseña de tu dispositivo my-PV. Si no hay una contraseña personalizada, usa la clave del dispositivo, que se encuentra en el menú de información del dispositivo (o en la etiqueta del HEA•THOR IoT)."
        }
      },
      "discovery_confirm": {
        "title": "{name}",
        "description": "¿Quieres configurar {name}?"
      },
      "discovery_auth": {
        "title": "{name}",
        "description": "¿Quieres configurar {name}?",
        "data": {
          "password": "Contraseña"
        },
        "data_description": {
          "password": "La contraseña de tu dispositivo my-PV. Si no hay una contraseña personalizada, usa la clave del dispositivo, que se encuentra en el menú de información del dispositivo (o en la etiqueta del HEA•THOR IoT)."
        }
      },
      "reauth_confirm": {
        "title": "{name} contraseña",
        "description": "La contraseña de tu dispositivo my-PV ha cambiado. Introduce la nueva contraseña.",
        "data": {
          "password": "Contraseña"
        },
        "data_description": {
          "password": "La contraseña de tu dispositivo my-PV. Si no hay una contraseña personalizada, usa la clave del dispositivo, que se encuentra en el menú de información del dispositivo (o en la etiqueta del HEA•THOR IoT)."
        }
      }
    },
    "error": {
      "cannot_connect": "No se pudo conectar",
      "invalid_password": "Contraseña no válida"
    },
    "abort": {
      "already_configured": "Este dispositivo ya está configurado",
      "cannot_connect": "No se pudo conectar",
      "unsupported_device": "Este dispositivo my-PV no es compatible",
