{
  "title": "myPV (Benutzerdefiniert)",
  "config": {
    "step": {
      "user": {
        "title": "my-PV Gerät",
        "description": "Gib die IP-Adresse oder den Hostnamen deines my-PV Geräts ein. Das Gerät wird vollständig lokal verwendet.",
        "data": {
          "host": "Host"
        },
        "data_description": {
          "host": "Die IP-Adresse oder der Hostname deines my-PV Geräts."
        }
      },
      "auth": {
        "title": "{name} Passwort",
        "data": {
          "password": "Passwort"
        },
        "data_description": {
          "password": "Das Passwort deines my-PV Geräts. Wenn kein eigenes Passwort gesetzt ist, verwende den Device Key aus dem Info-Menü des Geräts (oder vom Aufkleber des HEA•THOR IoT)."
        }
      },
      "discovery_confirm": {
        "title": "{name}",
        "description": "Möchtest du {name} einrichten?"
      },
      "discovery_auth": {
        "title": "{name}",
        "description": "Möchtest du {name} einrichten?",
        "data": {
          "password": "Passwort"
        },
        "data_description": {
          "password": "Das Passwort deines my-PV Geräts. Wenn kein eigenes Passwort gesetzt ist, verwende den Device Key aus dem Info-Menü des Geräts (oder vom Aufkleber des HEA•THOR IoT)."
        }
      },
      "reauth_confirm": {
        "title": "{name} Passwort",
        "description": "Das Passwort deines my-PV Geräts hat sich geändert. Gib das neue Passwort ein.",
        "data": {
          "password": "Passwort"
        },
        "data_description": {
          "password": "Das Passwort deines my-PV Geräts. Wenn kein eigenes Passwort gesetzt ist, verwende den Device Key aus dem Info-Menü des Geräts (oder vom Aufkleber des HEA•THOR IoT)."
        }
      }
    },
    "error": {
      "cannot_connect": "Verbindung fehlgeschlagen",
      "invalid_password": "Ungültiges Passwort"
    },
    "abort": {
      "already_configured": "Dieses Gerät ist bereits eingerichtet",
      "cannot_connect": "Verbindung fehlgeschlagen",
      "unsupported_device": "Dieses my-PV Gerät wird nicht unterstützt",
      "reauth_successful": "Die erneute Authentifizierung war erfolgreich"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "my-PV Optionen",
        "data": {
          "advanced": "Erweiterte Einstellungen anzeigen"
        },
        "data_description": {
          "advanced": "Erweiterte Einstellungen wie Netzwerkkonfiguration, Boost-Zeitpläne und Diagnose anzeigen."
        }
      }
    }
  },
  "exceptions": {
    "auth_error": {
      "message": "Authentifizierung fehlgeschlagen, bitte erneut authentifizieren."
