{
  "title": "myPV (Aangepast)",
  "config": {
    "step": {
      "user": {
        "title": "my-PV apparaat",
        "description": "Voer het IP-adres of de hostnaam van je my-PV apparaat in. Het apparaat wordt volledig lokaal gebruikt.",
        "data": {
          "host": "Host"
        },
        "data_description": {
          "host": "Het IP-adres of de hostnaam van je my-PV apparaat."
        }
      },
      "auth": {
        "title": "{name} wachtwoord",
        "data": {
          "password": "Wachtwoord"
        },
        "data_description": {
          "password": "Het wachtwoord van je my-PV apparaat. Als er geen eigen wachtwoord is ingesteld, gebruik dan de device key uit het infomenu van het apparaat (of op het label van de HEA•THOR IoT)."
        }
      },
      "discovery_confirm": {
        "title": "{name}",
        "description": "Wil je {name} instellen?"
      },
      "discovery_auth": {
        "title": "{name}",
        "description": "Wil je {name} instellen?",
        "data": {
          "password": "Wachtwoord"
        },
        "data_description": {
          "password": "Het wachtwoord van je my-PV apparaat. Als er geen eigen wachtwoord is ingesteld, gebruik dan de device key uit het infomenu van het apparaat (of op het label van de HEA•THOR IoT)."
        }
      },
      "reauth_confirm": {
        "title": "{name} wachtwoord",
        "description": "Het wachtwoord van je my-PV apparaat is gewijzigd. Voer het nieuwe wachtwoord in.",
        "data": {
          "password": "Wachtwoord"
        },
        "data_description": {
          "password": "Het wachtwoord van je my-PV apparaat. Als er geen eigen wachtwoord is ingesteld, gebruik dan de device key uit het infomenu van het apparaat (of op het label van de HEA•THOR IoT)."
        }
      }
    },
    "error": {
      "cannot_connect": "Verbinding mislukt",
      "invalid_password": "Ongeldig wachtwoord"
    },
    "abort": {
      "already_configured": "Dit apparaat is al geconfigureerd",
